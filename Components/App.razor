@inject IConfiguration Config
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/@(Config.GetValue<string>("BasePath"))" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/ubi-theme.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServerNoPrerender" />
</head>

<body>
    @* prerender:false so ProtectedSessionStorage auth restore works before [Authorize] *@
    <Routes @rendermode="InteractiveServerNoPrerender" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    private static readonly InteractiveServerRenderMode InteractiveServerNoPrerender =
        new(prerender: false);
}
