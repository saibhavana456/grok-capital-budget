@page "/login"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="login-shell">
    <div class="login-card">
        <div class="d-flex justify-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Style="font-size:48px;" />
        </div>
        <MudText Typo="Typo.h6" Class="login-title">IT Capital &amp; Revenue Budget Monitoring</MudText>
        <div class="login-accent"></div>

        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_pf"
                          Label="PF Number"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Enter valid PF number"
                          HelperText="Enter valid PF number"
                          Class="mb-3"
                          Immediate="true" />

            <MudTextField @bind-Value="_password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInput"
                          Required="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePassword"
                          Class="mb-3" />

            <MudText Typo="Typo.caption" Class="mb-1" Style="color:#475569;">Captcha</MudText>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="6">
                    <MudPaper Class="pa-3" Style="background:#f1f5f9;min-height:56px;display:flex;align-items:center;justify-content:center;">
                        <MudText Typo="Typo.subtitle2">@(_captcha?.QuestionText ?? "Loading...")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_captchaAnswer"
                                  Placeholder="Enter answer"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       FullWidth="true"
                       Disabled="_busy"
                       OnClick="DoLogin"
                       Class="mt-2"
                       Style="background:#c8102e;height:44px;font-weight:700;">
                @(_busy ? "Signing in..." : "Login")
            </MudButton>
        </MudForm>

        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-4" Style="color:#64748b;">
            Sample Maker PF 600110 · Checker 600221 · Admin 100001 (BypassAd local)
        </MudText>
    </div>
</div>

@code {
    private MudForm? _form;
    private bool _formValid;
    private bool _busy;
    private string _pf = "";
    private string _password = "";
    private string _captchaAnswer = "";
    private CaptchaQuestionDto? _captcha;
    private InputType _passwordInput = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        await LoadCaptcha();
    }

    private async Task LoadCaptcha()
    {
        try
        {
            _captcha = await AuthService.GetCaptchaAsync();
            _captchaAnswer = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Captcha load failed: {ex.Message}", Severity.Error);
        }
    }

    private void TogglePassword()
    {
        if (_passwordInput == InputType.Password)
        {
            _passwordInput = InputType.Text;
            _passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordInput = InputType.Password;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task DoLogin()
    {
        if (_form != null) await _form.Validate();
        if (!_formValid) return;

        _busy = true;
        try
        {
            var result = await AuthService.LoginAsync(new LoginRequestDto
            {
                PfNumber = _pf.Trim(),
                Password = _password,
                CaptchaAnswer = _captchaAnswer.Trim()
            }, string.Empty);

            if (!result.Success || result.User == null)
            {
                Snackbar.Add(result.Message, Severity.Error);
                await LoadCaptcha();
                return;
            }

            if (AuthStateProvider is CustomAuthStateProvider custom)
                await custom.MarkUserAsAuthenticated(result.User);

            Nav.NavigateTo("/portal");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadCaptcha();
        }
        finally
        {
            _busy = false;
        }
    }
}
