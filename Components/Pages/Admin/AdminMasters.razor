@page "/admin/masters"
@attribute [Authorize(Roles = "ADMIN")]
@using Microsoft.EntityFrameworkCore
@using IT_BUDGET_MONITORING_PORTAL.Data
@inject IMasterService MasterService
@inject IAuthService AuthService
@inject IStaffLookupService StaffLookup
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="admin-page">
<MudText Typo="Typo.h5" Style="color:#003366;font-weight:700;">Admin Masters</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Style="color:#64748b;">Department, Section, and Project masters</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
    <b>DIT Capital</b> = Maker/Checker on each <b>Project</b>.<br />
    <b>DIT Revenue</b> = Maker/Checker on each <b>Section</b> (Revenue is section-wise, not project).<br />
    <b>Other departments</b> = one Maker + one Checker on the <b>Department</b> only (capital). New Department cannot create DIT.<br />
    <b>Non-DIT projects</b> use an auto <b>General</b> section — use the Projects tab (Sections tab is optional).<br />
    <b>Staff lookup (View)</b> — Local: Oracle <code>STAFF_DETAILS</code> (EMPLID). Prod: Organisations <code>StaffDetails</code> when <code>Auth:UseOrganisationsDb=true</code>. Missing PF → “not found”.
</MudAlert>

<MudTabs Elevation="1" Rounded="true" PanelClass="pa-4">
    <MudTabPanel Text="Departments">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="NewDept">Add Department</MudButton>
        <MudTable Items="_departments" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Has Revenue</MudTh>
                <MudTh>Maker PF</MudTh><MudTh>Checker PF</MudTh><MudTh>Active</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.DeptCode</MudTd>
                <MudTd DataLabel="Name">@context.DeptName</MudTd>
                <MudTd DataLabel="Has Revenue">@context.HasRevenue</MudTd>
                <MudTd DataLabel="Maker PF">
                    @(AppConstants.IsDitDepartment(context.DeptCode) ? "— (Projects / Sections)" : (context.MakerPf ?? "—"))
                </MudTd>
                <MudTd DataLabel="Checker PF">
                    @(AppConstants.IsDitDepartment(context.DeptCode) ? "— (Projects / Sections)" : (context.CheckerPf ?? "—"))
                </MudTd>
                <MudTd DataLabel="Active">@context.IsActive</MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right;white-space:nowrap;">
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditDept(context))" />
                    </MudTooltip>
                    <MudTooltip Text="@(context.IsActive == "Y" ? "Set inactive" : "Already inactive — use Edit to set Active = Y")">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       Disabled="@(context.IsActive != "Y")"
                                       OnClick="@(() => SoftDeleteDept(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_editDept != null)
        {
            <MudPaper Class="pa-4 mt-3 admin-form-card" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#003366;font-weight:700;">
                    @(_editDept.DeptId == 0 ? "New" : "Edit") Department
                </MudText>

                @if (_editDept.DeptId == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        New departments are capital-only (non-DIT). Code cannot be <b>DIT</b> — edit the existing DIT row instead.
                    </MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Value="_editDept.DeptCode" Label="Code *" Variant="Variant.Outlined" Required="true"
                                      Disabled="@(_editDept.DeptId != 0 && _editDeptIsDit)"
                                      ValueChanged="@((string code) => OnDeptCodeChanged(code))" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editDept.DeptName" Label="Name *" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                </MudGrid>

                @if (_editDept.DeptId != 0 && _editDeptIsDit)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        Capital Maker/Checker on <b>Projects</b> · Revenue Maker/Checker on <b>Sections</b>.
                    </MudAlert>
                }
                else if (!_editDeptIsDit || _editDept.DeptId == 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2" Style="color:#003366;">
                        Department Maker / Checker
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_editDept.MakerPf" Label="Maker PF *" Variant="Variant.Outlined" Required="true" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       Disabled="_lookupBusy" OnClick="@(() => LookupPf(_editDept.MakerPf, isMaker: true))">
                                View Maker
                            </MudButton>
                            @if (_makerStaff != null)
                            {
                                <MudText Typo="Typo.caption" Style="color:#15803d;">
                                    @_makerStaff.EmpName
                                    @if (_makerStaff.ScaleNumber.HasValue) { <text> · Scale @_makerStaff.ScaleNumber</text> }
                                </MudText>
                            }
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_editDept.CheckerPf" Label="Checker PF *" Variant="Variant.Outlined" Required="true" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       Disabled="_lookupBusy" OnClick="@(() => LookupPf(_editDept.CheckerPf, isMaker: false))">
                                View Checker
                            </MudButton>
                            @if (_checkerStaff != null)
                            {
                                <MudText Typo="Typo.caption" Style="color:#15803d;">
                                    @_checkerStaff.EmpName
                                    @if (_checkerStaff.ScaleNumber.HasValue) { <text> · Scale @_checkerStaff.ScaleNumber</text> }
                                </MudText>
                            }
                        </MudItem>
                    </MudGrid>
                    @if (_makerStaff != null || _checkerStaff != null)
                    {
                        <MudTable Items="StaffPreviewRows" Dense="true" Hover="true" Class="mt-3" Elevation="0">
                            <HeaderContent>
                                <MudTh>Viewed as</MudTh><MudTh>PF</MudTh><MudTh>Name</MudTh><MudTh>Designation</MudTh>
                                <MudTh>Scale</MudTh><MudTh>Email</MudTh><MudTh>Phone</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Role</MudTd>
                                <MudTd>@context.Pf</MudTd>
                                <MudTd>@context.Name</MudTd>
                                <MudTd>@context.Designation</MudTd>
                                <MudTd>@(context.Scale ?? "—")</MudTd>
                                <MudTd>@(context.Email ?? "—")</MudTd>
                                <MudTd>@(context.Phone ?? "—")</MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudText Typo="Typo.caption" Class="mt-1" Style="color:#64748b;">
                            “Viewed as” is which button you clicked (Maker field vs Checker field) — not APP_USER role.
                            Designation/Scale come from staff master. Save still blocks Maker PF = Checker PF.
                        </MudText>
                    }
                }

                <MudText Typo="Typo.caption" Class="mt-3 mb-2" Style="color:#64748b;">
                    View Maker/Checker reads staff by EMPLID (scale, email, phone). Oracle STAFF_DETAILS locally; Organisations StaffDetails in prod.
                    APP_USER must exist (Maker/Checker). Admin is config login only (SCV AdminApp). Scale: Maker 1–4, Checker 4+.
                </MudText>
                @if (_editDept.DeptId != 0)
                {
                    <MudSelect T="string" @bind-Value="_editDept.IsActive" Label="Active *" Variant="Variant.Outlined"
                               Class="mt-2 mb-2" Style="max-width:220px;">
                        <MudSelectItem T="string" Value="@("Y")">Y — Active</MudSelectItem>
                        <MudSelectItem T="string" Value="@("N")">N — Inactive</MudSelectItem>
                    </MudSelect>
                }
                <MudStack Row="true" Spacing="2">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDept">Save</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="CancelDept">Cancel</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Sections">
        <MudGrid Class="admin-filter-row mb-2" Spacing="2">
            <MudItem xs="12" md="4" lg="3">
                <MudSelect T="long?" Value="_filterDeptId" Label="Department" Variant="Variant.Outlined" Dense="true"
                           ValueChanged="OnFilterDept" Class="admin-filter-field">
                    @foreach (var d in _departments)
                    {
                        <MudSelectItem T="long?" Value="@((long?)d.DeptId)">@d.DeptName (@d.DeptCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_filterDeptIsDit)
            {
                <MudItem xs="12" md="4" lg="3">
                    <MudSelect T="string" Value="_ditBudgetType" Label="Budget type *" Variant="Variant.Outlined" Dense="true"
                               ValueChanged="OnDitBudgetTypeChanged" Class="admin-filter-field"
                               Disabled="!_filterDeptId.HasValue">
                        <MudSelectItem T="string" Value="@("CAPITAL")">Capital</MudSelectItem>
                        <MudSelectItem T="string" Value="@("REVENUE")">Revenue</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" md="4" lg="3" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!CanAddSection)" OnClick="NewSection"
                           Class="admin-filter-action">
                    Add Section
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_filterDeptId.HasValue && _filterDeptIsDit && string.IsNullOrEmpty(_ditBudgetType))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Select <b>Capital</b> or <b>Revenue</b> before adding or editing a section.
            </MudAlert>
        }
        else if (_sectionIsRevenueMode)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                DIT Revenue — set <b>Revenue</b> Maker/Checker + allotment on each section (section-wise, not project).
            </MudAlert>
        }
        else if (_sectionIsCapitalMode)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                DIT Capital — section is code/name only. Capital Maker/Checker go on each <b>Project</b>.
            </MudAlert>
        }
        else if (_filterDeptId.HasValue && !_filterDeptIsDit)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Non-DIT uses Projects tab (auto General section). Sections tab optional.
            </MudAlert>
        }

        <MudTable Items="_sections" Dense="true" Hover="true" Class="admin-masters-table">
            <HeaderContent>
                <MudTh>Code</MudTh><MudTh>Name</MudTh>
                @if (_sectionIsRevenueMode)
                {
                    <MudTh>Rev Maker</MudTh><MudTh>Rev Checker</MudTh>
                }
                <MudTh>Active</MudTh><MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SectionCode</MudTd>
                <MudTd>@context.SectionName</MudTd>
                @if (_sectionIsRevenueMode)
                {
                    <MudTd>@(context.MakerPf ?? "—")</MudTd>
                    <MudTd>@(context.CheckerPf ?? "—")</MudTd>
                }
                <MudTd>@context.IsActive</MudTd>
                <MudTd Style="text-align:right;white-space:nowrap;">
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Disabled="@(_filterDeptIsDit && string.IsNullOrEmpty(_ditBudgetType))"
                                       OnClick="@(() => EditSection(context))" />
                    </MudTooltip>
                    <MudTooltip Text="@(context.IsActive == "Y" ? "Set inactive" : "Already inactive — use Edit to set Active = Y")">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       Disabled="@(context.IsActive != "Y")"
                                       OnClick="@(() => SoftDeleteSection(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Style="color:#64748b;">
                    @(_filterDeptId.HasValue ? "No sections yet — click Add Section." : "Select a department first.")
                </MudText>
            </NoRecordsContent>
        </MudTable>
        @if (_editSection != null)
        {
            <MudPaper Class="pa-4 mt-3 admin-form-card" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#003366;">
                    @(_editSection.SectionId == 0 ? "New" : "Edit") Section
                    @if (_sectionIsRevenueMode) { <text> (Revenue)</text> }
                    else if (_sectionIsCapitalMode) { <text> (Capital)</text> }
                </MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editSection.SectionCode" Label="Code" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editSection.SectionName" Label="Name *" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                @if (_sectionIsRevenueMode)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1" Style="color:#003366;">
                        Revenue Maker / Checker (section-wise)
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_editSection.MakerPf" Label="Revenue Maker PF *" Variant="Variant.Outlined" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       Disabled="_lookupBusy" OnClick="@(() => LookupPf(_editSection.MakerPf, isMaker: true))">
                                View Maker
                            </MudButton>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_editSection.CheckerPf" Label="Revenue Checker PF *" Variant="Variant.Outlined" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       Disabled="_lookupBusy" OnClick="@(() => LookupPf(_editSection.CheckerPf, isMaker: false))">
                                View Checker
                            </MudButton>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_sectionRevenueAllotted"
                                             Label="@($"Total Revenue Allotted (Cr) FY {_allotmentFy}")"
                                             Variant="Variant.Outlined" Min="0" />
                        </MudItem>
                    </MudGrid>
                }

                @if (_editSection.SectionId != 0)
                {
                    <MudSelect T="string" @bind-Value="_editSection.IsActive" Label="Active *" Variant="Variant.Outlined"
                               Class="mt-3 mb-1" Style="max-width:220px;">
                        <MudSelectItem T="string" Value="@("Y")">Y — Active</MudSelectItem>
                        <MudSelectItem T="string" Value="@("N")">N — Inactive</MudSelectItem>
                    </MudSelect>
                }

                <MudStack Row="true" Class="mt-3" Spacing="2">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSection">Save</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _editSection = null">Cancel</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Projects">
        <MudGrid Class="admin-filter-row mb-2" Spacing="2">
            <MudItem xs="12" md="4" lg="3">
                <MudSelect T="long?" Value="_filterDeptId" Label="Department" Variant="Variant.Outlined" Dense="true"
                           ValueChanged="OnFilterDeptForProjects" Class="admin-filter-field">
                    @foreach (var d in _departments)
                    {
                        <MudSelectItem T="long?" Value="@((long?)d.DeptId)">@d.DeptName (@d.DeptCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_filterDeptIsDit)
            {
                <MudItem xs="12" md="4" lg="3">
                    <MudSelect T="long?" Value="_filterSectionId" Label="Section" Variant="Variant.Outlined" Dense="true"
                               ValueChanged="OnFilterSection" Class="admin-filter-field"
                               Disabled="!_filterDeptId.HasValue">
                        @foreach (var s in _sections)
                        {
                            <MudSelectItem T="long?" Value="@((long?)s.SectionId)">@s.SectionName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else if (_filterDeptId.HasValue)
            {
                <MudItem xs="12" md="4" lg="3">
                    <MudTextField Value="@(_generalSectionLabel)" Label="Section" Variant="Variant.Outlined"
                                  Disabled="true" Class="admin-filter-field" />
                </MudItem>
            }
            <MudItem xs="12" md="4" lg="3" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="!_filterSectionId.HasValue" OnClick="NewProject"
                           Class="admin-filter-action">
                    Add Project
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_filterDeptId.HasValue && _filterDeptIsDit)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                <b>DIT Capital</b> — select Section → Add Project with Capital Maker/Checker + allotment. Maker ≠ Checker on the same project.
            </MudAlert>
        }
        else if (_filterDeptId.HasValue && !_filterDeptIsDit)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Non-DIT: Maker/Checker are on the Department. Projects use auto <b>General</b> section — name/code/allotment only.
            </MudAlert>
        }

        @if (_filterDeptId.HasValue && _filterDeptIsDit && _sections.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                No sections for this department yet. Open the <b>Sections</b> tab (Budget type = Capital), Add Section, then return here.
            </MudAlert>
        }
        else if (_filterDeptId.HasValue && _filterDeptIsDit && !_filterSectionId.HasValue)
        {
            <MudText Typo="Typo.caption" Class="mb-3" Style="color:#64748b;">
                Select a Section above to list projects and enable Add Project.
            </MudText>
        }

        <MudTable Items="_projects" Dense="true" Hover="true" Class="admin-masters-table">
            <HeaderContent>
                <MudTh>Code</MudTh><MudTh>Name</MudTh>
                @if (_filterDeptIsDit)
                {
                    <MudTh>Cap Maker</MudTh><MudTh>Cap Checker</MudTh>
                }
                <MudTh>Active</MudTh><MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ProjectCode</MudTd>
                <MudTd>@context.ProjectName</MudTd>
                @if (_filterDeptIsDit)
                {
                    <MudTd>@(context.MakerPf ?? "—")</MudTd>
                    <MudTd>@(context.CheckerPf ?? "—")</MudTd>
                }
                <MudTd>@context.IsActive</MudTd>
                <MudTd Style="text-align:right;white-space:nowrap;">
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditProject(context))" />
                    </MudTooltip>
                    <MudTooltip Text="@(context.IsActive == "Y" ? "Set inactive" : "Already inactive — use Edit to set Active = Y")">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       Disabled="@(context.IsActive != "Y")"
                                       OnClick="@(() => SoftDeleteProject(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Style="color:#64748b;">
                    @(_filterSectionId.HasValue ? "No projects in this section yet." : "Select a department/section to view projects.")
                </MudText>
            </NoRecordsContent>
        </MudTable>
        @if (_editProject != null)
        {
            <MudPaper Class="pa-4 mt-3 admin-form-card" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#003366;">
                    @(_editProject.ProjectId == 0 ? "New" : "Edit") Project + FY allotment
                </MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editProject.ProjectCode" Label="Code" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editProject.ProjectName" Label="Name *" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_projectSpillover" Label="@($"Spillover Allotted (Cr) FY {_allotmentFy}")"
                                         Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_projectFresh" Label="Fresh Allotted (Cr)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal" Value="@(_projectSpillover + _projectFresh)" Label="Total Allotted (auto)"
                                         Variant="Variant.Outlined" Disabled="true" />
                    </MudItem>
                </MudGrid>

                @if (_filterDeptIsDit)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1" Style="color:#003366;">
                        Capital Maker / Checker (project-wise — DIT)
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_editProject.MakerPf" Label="Capital Maker PF *" Variant="Variant.Outlined" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       Disabled="_lookupBusy" OnClick="@(() => LookupPf(_editProject.MakerPf, isMaker: true))">
                                View Maker
                            </MudButton>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_editProject.CheckerPf" Label="Capital Checker PF *" Variant="Variant.Outlined" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       Disabled="_lookupBusy" OnClick="@(() => LookupPf(_editProject.CheckerPf, isMaker: false))">
                                View Checker
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                }

                @if (_editProject.ProjectId != 0)
                {
                    <MudSelect T="string" @bind-Value="_editProject.IsActive" Label="Active *" Variant="Variant.Outlined"
                               Class="mt-3 mb-1" Style="max-width:220px;">
                        <MudSelectItem T="string" Value="@("Y")">Y — Active</MudSelectItem>
                        <MudSelectItem T="string" Value="@("N")">N — Inactive</MudSelectItem>
                    </MudSelect>
                }

                <MudStack Row="true" Class="mt-3" Spacing="2">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProject">Save</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _editProject = null">Cancel</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Month Unlock">
        <MudText Typo="Typo.caption" Class="mb-3" Style="color:#64748b;">
            After a month’s deadline (end of next calendar month), Admin can enable entry for months with no PENDING/APPROVED submission.
            <b>Capital</b> unlock → select project (writes PROJECT_ID). <b>Revenue</b> unlock → Unlock type = Revenue + section (writes SECTION_ID).
            After Enable, refresh SQL Developer Data tab — a row must appear in ENTRY_MONTH_UNLOCK. Then Maker opens that month on Portal/Entry.
        </MudText>

        <MudGrid Class="admin-filter-row mb-3" Spacing="2">
            <MudItem xs="12" md="3">
                <MudSelect T="string" Value="_unlockMode" Label="Unlock type" Variant="Variant.Outlined" Dense="true"
                           ValueChanged="OnUnlockModeChanged" Class="admin-filter-field">
                    <MudSelectItem T="string" Value="@("CAPITAL")">Capital (project)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("REVENUE")">Revenue (section)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="long?" Value="_unlockDeptId" Label="Department" Variant="Variant.Outlined" Dense="true"
                           ValueChanged="OnUnlockDeptChanged" Class="admin-filter-field">
                    @foreach (var d in UnlockDepartments)
                    {
                        <MudSelectItem T="long?" Value="@((long?)d.DeptId)">@d.DeptName (@d.DeptCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="long?" Value="_unlockSectionId" Label="Section" Variant="Variant.Outlined" Dense="true"
                           ValueChanged="OnUnlockSectionChanged" Class="admin-filter-field"
                           Disabled="!_unlockDeptId.HasValue">
                    @foreach (var s in _unlockSections)
                    {
                        <MudSelectItem T="long?" Value="@((long?)s.SectionId)">@s.SectionName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_unlockMode == "CAPITAL")
            {
                <MudItem xs="12" md="3">
                    <MudSelect T="long?" Value="_unlockProjectId" Label="Project" Variant="Variant.Outlined" Dense="true"
                               ValueChanged="OnUnlockProjectChanged" Class="admin-filter-field"
                               Disabled="!_unlockSectionId.HasValue">
                        @foreach (var p in _unlockProjects)
                        {
                            <MudSelectItem T="long?" Value="@((long?)p.ProjectId)">@p.ProjectName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#003366;">
            Unlockable months — FY @_unlockFy
            <MudText Typo="Typo.caption" Style="color:#64748b;">
                Today: @DateTime.Now.ToString("dd-MMM-yyyy"). Deadline for a month = last day of the next calendar month.
                Example on 08-Aug-2026: April–June need unlock if not submitted; July still open until 31-Aug; August open until 30-Sep.
            </MudText>
        </MudText>
        <MudTable Items="_unlockableMonths" Dense="true" Hover="true" Class="admin-masters-table mb-4">
            <HeaderContent>
                <MudTh>Month</MudTh>
                <MudTh>Deadline ended</MudTh>
                <MudTh>Prior months still missing</MudTh>
                <MudTh Style="text-align:right;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Month</MudTd>
                <MudTd>@context.DeadlineEnd.ToString("dd-MMM-yyyy")</MudTd>
                <MudTd>@context.PriorGaps</MudTd>
                <MudTd Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="_unlockBusy"
                               OnClick="@(() => EnableMonthUnlockAsync(context.Month))">
                        Enable
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Style="color:#64748b;">
                    @UnlockEmptyMessage
                </MudText>
            </NoRecordsContent>
        </MudTable>

        @if (_unlockStatusRows.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#003366;">
                Month status (why grey on Maker portal)
            </MudText>
            <MudTable Items="_unlockStatusRows" Dense="true" Hover="true" Class="admin-masters-table">
                <HeaderContent>
                    <MudTh>Month</MudTh>
                    <MudTh>Deadline</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Month</MudTd>
                    <MudTd>@context.DeadlineEnd.ToString("dd-MMM-yyyy")</MudTd>
                    <MudTd>@context.Status</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Revenue Heads">
        <MudText Typo="Typo.caption" Class="mb-3" Style="color:#64748b;">
            Fixed revenue head list used on Revenue monthly entry (read-only here).
        </MudText>
        <MudTable Items="_heads" Dense="true">
            <HeaderContent>
                <MudTh>Order</MudTh><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Active</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DisplayOrder</MudTd>
                <MudTd>@context.HeadCode</MudTd>
                <MudTd>@context.HeadName</MudTd>
                <MudTd>@context.IsActive</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>
</MudTabs>
</div>

@code {
    private List<Department> _departments = new();
    private List<Section> _sections = new();
    private List<Project> _projects = new();
    private List<RevenueHead> _heads = new();
    private Department? _editDept;
    private Section? _editSection;
    private Project? _editProject;
    private long? _filterDeptId;
    private long? _filterSectionId;
    /// <summary>DIT Sections tab mode: "CAPITAL" | "REVENUE" | null.</summary>
    private string? _ditBudgetType;
    private StaffLookupResult? _makerStaff;
    private StaffLookupResult? _checkerStaff;
    private bool _lookupBusy;
    private decimal _sectionRevenueAllotted;
    private decimal _projectSpillover;
    private decimal _projectFresh;
    private string _allotmentFy = AppConstants.CurrentFinancialYear();
    private string _generalSectionLabel = AppConstants.DefaultCapitalSectionName;

    // Month Unlock
    private string _unlockMode = "CAPITAL";
    private long? _unlockDeptId;
    private long? _unlockSectionId;
    private long? _unlockProjectId;
    private List<Section> _unlockSections = new();
    private List<Project> _unlockProjects = new();
    private List<UnlockMonthRow> _unlockableMonths = new();
    private List<UnlockStatusRow> _unlockStatusRows = new();
    private string _unlockFy = AppConstants.CurrentFinancialYear();
    private bool _unlockBusy;

    private bool _filterDeptIsDit =>
        AppConstants.IsDitDepartment(_departments.FirstOrDefault(d => d.DeptId == _filterDeptId)?.DeptCode);
    private bool _editDeptIsDit =>
        _editDept != null && AppConstants.IsDitDepartment(_editDept.DeptCode);
    private bool _sectionIsRevenueMode =>
        _filterDeptIsDit && string.Equals(_ditBudgetType, "REVENUE", StringComparison.OrdinalIgnoreCase);
    private bool _sectionIsCapitalMode =>
        _filterDeptIsDit && string.Equals(_ditBudgetType, "CAPITAL", StringComparison.OrdinalIgnoreCase);
    private bool CanAddSection =>
        _filterDeptId.HasValue && (!_filterDeptIsDit || !string.IsNullOrEmpty(_ditBudgetType));

    private IEnumerable<Department> UnlockDepartments =>
        _unlockMode == "REVENUE"
            ? _departments.Where(d => AppConstants.IsDitDepartment(d.DeptCode))
            : _departments;

    private string UnlockEmptyMessage
    {
        get
        {
            if (_unlockMode == "CAPITAL" && !_unlockProjectId.HasValue)
                return "Select department → section → project to list unlockable months.";
            if (_unlockMode == "REVENUE" && !_unlockSectionId.HasValue)
                return "Select DIT department → section to list unlockable months.";
            return "No months need Enable: either deadline not passed yet, already PENDING/APPROVED, or already unlocked. See status table below.";
        }
    }

    private IEnumerable<StaffPreviewRow> StaffPreviewRows
    {
        get
        {
            if (_makerStaff != null)
                yield return ToPreview("Maker field", _editDept?.MakerPf, _makerStaff);
            if (_checkerStaff != null)
                yield return ToPreview("Checker field", _editDept?.CheckerPf, _checkerStaff);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadDepts();
        _heads = await MasterService.GetRevenueHeadsAsync();
        _unlockFy = AppConstants.CurrentFinancialYear();
    }

    private async Task ReloadDepts() =>
        _departments = await MasterService.GetDepartmentsAsync(false);

    private void NewDept()
    {
        _editDept = new Department { HasRevenue = "N", IsActive = "Y" };
        _makerStaff = null;
        _checkerStaff = null;
    }

    private void EditDept(Department d)
    {
        _editDept = new Department
        {
            DeptId = d.DeptId, DeptCode = d.DeptCode, DeptName = d.DeptName,
            HasRevenue = d.HasRevenue, MakerPf = d.MakerPf, CheckerPf = d.CheckerPf, IsActive = d.IsActive
        };
        _makerStaff = null;
        _checkerStaff = null;
    }

    private void OnDeptCodeChanged(string code)
    {
        if (_editDept == null) return;
        _editDept.DeptCode = code;
        // New Department cannot create DIT — block as soon as code is typed DIT.
        if (_editDept.DeptId == 0 && AppConstants.IsDitDepartment(code))
            Snackbar.Add(AppConstants.DitAlreadyExistsMessage, Severity.Warning);
    }

    private void CancelDept()
    {
        _editDept = null;
        _makerStaff = null;
        _checkerStaff = null;
    }

    private async Task LookupPf(string? pf, bool isMaker)
    {
        if (string.IsNullOrWhiteSpace(pf))
        {
            Snackbar.Add(isMaker ? AppConstants.MakerPfRequiredMessage : AppConstants.CheckerPfRequiredMessage, Severity.Warning);
            return;
        }

        _lookupBusy = true;
        try
        {
            var pfNorm = pf.Trim();
            var staff = await StaffLookup.LookupByPfAsync(pfNorm);
            if (staff == null)
            {
                if (isMaker) _makerStaff = null; else _checkerStaff = null;
                Snackbar.Add(string.Format(AppConstants.StaffNotInOrganisationsMessage, pfNorm), Severity.Warning);
                return;
            }

            if (isMaker) _makerStaff = staff; else _checkerStaff = staff;
            var scaleText = staff.ScaleNumber.HasValue ? $" · Scale {staff.ScaleNumber}" : "";
            Snackbar.Add($"Found {staff.EmpName} ({staff.EmpId}){scaleText}", Severity.Success);

            // Preview only — Save still enforces rules. Warn early when slot vs scale / same PF.
            if (_editDept != null)
            {
                var otherPf = isMaker ? _editDept.CheckerPf : _editDept.MakerPf;
                if (!string.IsNullOrWhiteSpace(otherPf)
                    && string.Equals(otherPf.Trim(), pfNorm, StringComparison.OrdinalIgnoreCase))
                {
                    Snackbar.Add(AppConstants.MakerCheckerSamePfMessage, Severity.Warning);
                }
            }

            if (isMaker && !AppConstants.IsMakerScaleAllowed(staff.ScaleNumber))
            {
                Snackbar.Add(string.Format(AppConstants.MakerScaleInvalidMessage, pfNorm,
                    staff.ScaleNumber?.ToString() ?? staff.ScaleCode ?? staff.ScaleDescr ?? "unknown"), Severity.Warning);
            }
            else if (!isMaker && !AppConstants.IsCheckerScaleAllowed(staff.ScaleNumber))
            {
                Snackbar.Add(string.Format(AppConstants.CheckerScaleInvalidMessage, pfNorm,
                    staff.ScaleNumber?.ToString() ?? staff.ScaleCode ?? staff.ScaleDescr ?? "unknown"), Severity.Warning);
            }
        }
        finally { _lookupBusy = false; }
    }

    private static StaffPreviewRow ToPreview(string viewedAsSlot, string? pf, StaffLookupResult s) => new()
    {
        Role = viewedAsSlot,
        Pf = pf ?? s.EmpId,
        Name = s.EmpName,
        Designation = s.Designation ?? "—",
        Scale = s.ScaleNumber?.ToString()
                ?? (string.IsNullOrWhiteSpace(s.ScaleCode) ? null : s.ScaleCode),
        Email = s.Email,
        Phone = s.Phone
    };

    private async Task SaveDept()
    {
        if (_editDept == null) return;

        // New Department: always capital-only; cannot create DIT.
        if (_editDept.DeptId == 0)
        {
            if (AppConstants.IsDitDepartment(_editDept.DeptCode))
            {
                Snackbar.Add(AppConstants.DitAlreadyExistsMessage, Severity.Error);
                return;
            }
            _editDept.HasRevenue = "N";
            _editDept.IsActive = "Y";
        }
        else if (AppConstants.IsDitDepartment(_editDept.DeptCode))
        {
            _editDept.MakerPf = null;
            _editDept.CheckerPf = null;
            _editDept.HasRevenue = "Y";
        }
        else
        {
            _editDept.HasRevenue = "N";
        }

        var isNew = _editDept.DeptId == 0;
        var ok = await ConfirmAsync(
            isNew ? "Confirm add department" : "Confirm save department",
            isNew
                ? "Create this department as Active (Y)?"
                : $"Save department changes? Active will be {_editDept.IsActive}.",
            isNew ? "Add department" : "Save changes",
            Color.Primary,
            _editDept.DeptCode,
            [
                new("Code", _editDept.DeptCode ?? ""),
                new("Name", _editDept.DeptName ?? ""),
                new("Active", isNew ? "Y" : (_editDept.IsActive ?? "Y"), "accent")
            ]);
        if (!ok) return;

        var r = await MasterService.SaveDepartmentAsync(_editDept, AuthService.CurrentUser!.PfNo);
        Snackbar.Add(r.Message, r.Success ? Severity.Success : Severity.Error);
        if (!r.Success) return;
        CancelDept();
        await ReloadDepts();
    }

    private async Task SoftDeleteDept(Department d)
    {
        if (d.IsActive != "Y")
        {
            Snackbar.Add("Already inactive. Open Edit and set Active = Y to reactivate.", Severity.Info);
            return;
        }

        var ok = await ConfirmAsync(
            "Set department inactive?",
            "This sets Active = N (soft delete). You can reactivate later from Edit → Active = Y.",
            "Set inactive",
            Color.Warning,
            d.DeptCode,
            [
                new("Code", d.DeptCode ?? ""),
                new("Name", d.DeptName ?? ""),
                new("Current Active", d.IsActive ?? "N", "accent")
            ],
            Icons.Material.Filled.DeleteOutline);
        if (!ok) return;

        await MasterService.SoftDeleteDepartmentAsync(d.DeptId, AuthService.CurrentUser!.PfNo);
        Snackbar.Add($"Department '{d.DeptCode}' set inactive (Active = N).", Severity.Success);
        if (_editDept?.DeptId == d.DeptId) CancelDept();
        await ReloadDepts();
    }

    private async Task OnFilterDept(long? id)
    {
        _filterDeptId = id;
        _ditBudgetType = null;
        _sections = id.HasValue ? await MasterService.GetSectionsByDeptAsync(id.Value, false) : new();
        _projects.Clear();
        _filterSectionId = null;
        _editSection = null;
        _editProject = null;
        _makerStaff = null;
        _checkerStaff = null;
        _generalSectionLabel = AppConstants.DefaultCapitalSectionName;
    }

    private async Task OnDitBudgetTypeChanged(string? type)
    {
        _ditBudgetType = type;
        _editSection = null;
        _makerStaff = null;
        _checkerStaff = null;
        await Task.CompletedTask;
    }

    private async Task OnFilterDeptForProjects(long? id)
    {
        _filterDeptId = id;
        _editProject = null;
        _editSection = null;
        _makerStaff = null;
        _checkerStaff = null;
        _projects.Clear();
        _filterSectionId = null;
        _generalSectionLabel = AppConstants.DefaultCapitalSectionName;

        if (!id.HasValue)
        {
            _sections = new();
            return;
        }

        var dept = _departments.FirstOrDefault(d => d.DeptId == id.Value);
        if (dept != null && !AppConstants.IsDitDepartment(dept.DeptCode))
        {
            var section = await MasterService.EnsureDefaultCapitalSectionAsync(
                id.Value, dept.DeptName, AuthService.CurrentUser!.PfNo);
            _sections = await MasterService.GetSectionsByDeptAsync(id.Value, false);
            _filterSectionId = section.SectionId;
            _generalSectionLabel = string.IsNullOrWhiteSpace(section.SectionName)
                ? AppConstants.DefaultCapitalSectionName
                : section.SectionName;
            _projects = await MasterService.GetProjectsBySectionAsync(section.SectionId, false);
        }
        else
        {
            _sections = await MasterService.GetSectionsByDeptAsync(id.Value, false);
        }
    }

    private void NewSection()
    {
        if (!CanAddSection) return;
        _editSection = new Section { DeptId = _filterDeptId!.Value, IsActive = "Y" };
        _sectionRevenueAllotted = 0;
        _allotmentFy = AppConstants.CurrentFinancialYear();
        _makerStaff = null;
        _checkerStaff = null;
    }

    private async Task EditSection(Section s)
    {
        if (_filterDeptIsDit && string.IsNullOrEmpty(_ditBudgetType))
        {
            Snackbar.Add("Select Capital or Revenue budget type first.", Severity.Warning);
            return;
        }

        _editSection = new Section
        {
            SectionId = s.SectionId, DeptId = s.DeptId, SectionCode = s.SectionCode,
            SectionName = s.SectionName, Description = s.Description, IsActive = s.IsActive,
            MakerPf = s.MakerPf, CheckerPf = s.CheckerPf
        };
        _allotmentFy = AppConstants.CurrentFinancialYear();
        if (_sectionIsRevenueMode)
        {
            var allot = await MasterService.GetSectionRevenueAllotmentAsync(s.SectionId, _allotmentFy);
            _sectionRevenueAllotted = allot?.TotalAllotted ?? 0;
        }
        else
        {
            _sectionRevenueAllotted = 0;
        }
        _makerStaff = null;
        _checkerStaff = null;
    }

    private async Task SaveSection()
    {
        if (_editSection == null) return;

        var forRevenue = _sectionIsRevenueMode;
        if (!forRevenue)
        {
            _editSection.MakerPf = null;
            _editSection.CheckerPf = null;
        }

        if (_editSection.SectionId == 0)
            _editSection.IsActive = "Y";

        var isNew = _editSection.SectionId == 0;
        var ok = await ConfirmAsync(
            isNew ? "Confirm add section" : "Confirm save section",
            isNew
                ? "Create this section as Active (Y)?"
                : $"Save section changes? Active will be {_editSection.IsActive}.",
            isNew ? "Add section" : "Save changes",
            Color.Primary,
            _editSection.SectionCode,
            [
                new("Code", _editSection.SectionCode ?? ""),
                new("Name", _editSection.SectionName ?? ""),
                new("Mode", forRevenue ? "Revenue" : "Capital"),
                new("Active", isNew ? "Y" : (_editSection.IsActive ?? "Y"), "accent")
            ]);
        if (!ok) return;

        decimal? rev = forRevenue ? _sectionRevenueAllotted : null;
        var r = await MasterService.SaveSectionAsync(
            _editSection, AuthService.CurrentUser!.PfNo, rev, _allotmentFy, forRevenue: forRevenue);
        Snackbar.Add(r.Message, r.Success ? Severity.Success : Severity.Error);
        if (!r.Success) return;
        _editSection = null;
        var savedType = _ditBudgetType;
        await OnFilterDept(_filterDeptId);
        _ditBudgetType = savedType;
    }

    private async Task SoftDeleteSection(Section s)
    {
        if (s.IsActive != "Y")
        {
            Snackbar.Add("Already inactive. Open Edit and set Active = Y to reactivate.", Severity.Info);
            return;
        }

        var ok = await ConfirmAsync(
            "Set section inactive?",
            "This sets Active = N (soft delete). You can reactivate later from Edit → Active = Y.",
            "Set inactive",
            Color.Warning,
            s.SectionCode,
            [
                new("Code", s.SectionCode ?? ""),
                new("Name", s.SectionName),
                new("Current Active", s.IsActive, "accent")
            ],
            Icons.Material.Filled.DeleteOutline);
        if (!ok) return;

        var savedType = _ditBudgetType;
        await MasterService.SoftDeleteSectionAsync(s.SectionId, AuthService.CurrentUser!.PfNo);
        Snackbar.Add($"Section '{s.SectionName}' set inactive (Active = N).", Severity.Success);
        if (_editSection?.SectionId == s.SectionId) _editSection = null;
        await OnFilterDept(_filterDeptId);
        _ditBudgetType = savedType;
    }

    private async Task OnFilterSection(long? id)
    {
        _filterSectionId = id;
        _projects = id.HasValue ? await MasterService.GetProjectsBySectionAsync(id.Value, false) : new();
        _editProject = null;
        _makerStaff = null;
        _checkerStaff = null;
    }

    private void NewProject()
    {
        _editProject = new Project { SectionId = _filterSectionId!.Value, IsActive = "Y" };
        _projectSpillover = 0;
        _projectFresh = 0;
        _allotmentFy = AppConstants.CurrentFinancialYear();
        _makerStaff = null;
        _checkerStaff = null;
    }

    private async Task EditProject(Project p)
    {
        _editProject = new Project
        {
            ProjectId = p.ProjectId, SectionId = p.SectionId, ProjectCode = p.ProjectCode,
            ProjectName = p.ProjectName, IsActive = p.IsActive,
            MakerPf = p.MakerPf, CheckerPf = p.CheckerPf
        };
        _allotmentFy = AppConstants.CurrentFinancialYear();
        var allot = await MasterService.GetProjectAllotmentAsync(p.ProjectId, _allotmentFy);
        _projectSpillover = allot?.SpilloverAllotted ?? 0;
        _projectFresh = allot?.FreshAllotted ?? 0;
        _makerStaff = null;
        _checkerStaff = null;
    }

    private async Task SaveProject()
    {
        if (_editProject == null) return;
        if (!_filterDeptIsDit)
        {
            _editProject.MakerPf = null;
            _editProject.CheckerPf = null;
        }

        if (_editProject.ProjectId == 0)
            _editProject.IsActive = "Y";

        var isNew = _editProject.ProjectId == 0;
        var ok = await ConfirmAsync(
            isNew ? "Confirm add project" : "Confirm save project",
            isNew
                ? "Create this project as Active (Y)?"
                : $"Save project changes? Active will be {_editProject.IsActive}.",
            isNew ? "Add project" : "Save changes",
            Color.Primary,
            _editProject.ProjectCode,
            [
                new("Code", _editProject.ProjectCode ?? ""),
                new("Name", _editProject.ProjectName ?? ""),
                new("Active", isNew ? "Y" : (_editProject.IsActive ?? "Y"), "accent")
            ]);
        if (!ok) return;

        var r = await MasterService.SaveProjectAsync(
            _editProject, AuthService.CurrentUser!.PfNo,
            _projectSpillover, _projectFresh, _allotmentFy);
        Snackbar.Add(r.Message, r.Success ? Severity.Success : Severity.Error);
        if (!r.Success) return;
        _editProject = null;
        await OnFilterSection(_filterSectionId);
    }

    private async Task SoftDeleteProject(Project p)
    {
        if (p.IsActive != "Y")
        {
            Snackbar.Add("Already inactive. Open Edit and set Active = Y to reactivate.", Severity.Info);
            return;
        }

        var ok = await ConfirmAsync(
            "Set project inactive?",
            "This sets Active = N (soft delete). You can reactivate later from Edit → Active = Y.",
            "Set inactive",
            Color.Warning,
            p.ProjectCode,
            [
                new("Code", p.ProjectCode ?? ""),
                new("Name", p.ProjectName),
                new("Current Active", p.IsActive, "accent")
            ],
            Icons.Material.Filled.DeleteOutline);
        if (!ok) return;

        await MasterService.SoftDeleteProjectAsync(p.ProjectId, AuthService.CurrentUser!.PfNo);
        Snackbar.Add($"Project '{p.ProjectName}' set inactive (Active = N).", Severity.Success);
        if (_editProject?.ProjectId == p.ProjectId) _editProject = null;
        await OnFilterSection(_filterSectionId);
    }

    // ── Month Unlock ──────────────────────────────────────────────────────────

    private async Task OnUnlockModeChanged(string mode)
    {
        _unlockMode = mode;
        _unlockDeptId = null;
        _unlockSectionId = null;
        _unlockProjectId = null;
        _unlockSections = new();
        _unlockProjects = new();
        _unlockableMonths = new();
        await Task.CompletedTask;
    }

    private async Task OnUnlockDeptChanged(long? id)
    {
        _unlockDeptId = id;
        _unlockSectionId = null;
        _unlockProjectId = null;
        _unlockProjects = new();
        _unlockableMonths = new();
        _unlockSections = id.HasValue
            ? await MasterService.GetSectionsByDeptAsync(id.Value, true)
            : new();
    }

    private async Task OnUnlockSectionChanged(long? id)
    {
        _unlockSectionId = id;
        _unlockProjectId = null;
        _unlockableMonths = new();
        if (_unlockMode == "CAPITAL")
        {
            _unlockProjects = id.HasValue
                ? await MasterService.GetProjectsBySectionAsync(id.Value, true)
                : new();
        }
        else if (_unlockMode == "REVENUE" && id.HasValue)
        {
            await LoadUnlockableMonthsAsync();
        }
    }

    private async Task OnUnlockProjectChanged(long? id)
    {
        _unlockProjectId = id;
        _unlockableMonths = new();
        if (id.HasValue)
            await LoadUnlockableMonthsAsync();
    }

    private async Task LoadUnlockableMonthsAsync()
    {
        _unlockFy = AppConstants.CurrentFinancialYear();
        var now = DateTime.Now;
        await using var db = await DbFactory.CreateDbContextAsync();

        HashSet<string> submitted;
        HashSet<string> unlocked;

        if (_unlockMode == "CAPITAL" && _unlockProjectId.HasValue)
        {
            var projectId = _unlockProjectId.Value;
            submitted = (await db.CapitalMonthlyEntries.AsNoTracking()
                    .Where(e => e.ProjectId == projectId
                                && e.FinancialYear == _unlockFy
                                && e.IsActive == "Y"
                                && (e.EntryStatus == AppConstants.EntryStatus.Pending
                                    || e.EntryStatus == AppConstants.EntryStatus.Approved))
                    .Select(e => e.EntryMonth)
                    .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            unlocked = (await db.EntryMonthUnlocks.AsNoTracking()
                    .Where(u => u.ProjectId == projectId
                                && u.FinancialYear == _unlockFy
                                && u.IsEnabled == "Y")
                    .Select(u => u.EntryMonth)
                    .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        else if (_unlockMode == "REVENUE" && _unlockSectionId.HasValue)
        {
            var sectionId = _unlockSectionId.Value;
            submitted = (await db.RevenueMonthlyEntries.AsNoTracking()
                    .Where(e => e.SectionId == sectionId
                                && e.FinancialYear == _unlockFy
                                && e.IsActive == "Y"
                                && (e.EntryStatus == AppConstants.EntryStatus.Pending
                                    || e.EntryStatus == AppConstants.EntryStatus.Approved))
                    .Select(e => e.EntryMonth)
                    .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            unlocked = (await db.EntryMonthUnlocks.AsNoTracking()
                    .Where(u => u.SectionId == sectionId
                                && u.FinancialYear == _unlockFy
                                && u.IsEnabled == "Y")
                    .Select(u => u.EntryMonth)
                    .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            _unlockableMonths = new();
            _unlockStatusRows = new();
            return;
        }

        // Expired months with no PENDING/APPROVED entry and not already unlocked.
        _unlockableMonths = new();
        _unlockStatusRows = new();
        foreach (var m in AppConstants.FyMonths)
        {
            if (AppConstants.IsFutureMonth(m, now)) continue;

            var deadline = AppConstants.GetMonthDeadlineEnd(m, now);
            var withinDeadline = now <= deadline;
            var isSubmitted = submitted.Contains(m);
            var isUnlocked = unlocked.Contains(m);

            string status;
            if (isSubmitted) status = "Already submitted (PENDING/APPROVED) — no unlock needed";
            else if (isUnlocked) status = "Already unlocked by Admin — Maker can select on Portal";
            else if (withinDeadline) status = "Within deadline — Maker can select without unlock";
            else status = "Deadline passed — needs Enable below";

            _unlockStatusRows.Add(new UnlockStatusRow
            {
                Month = m,
                DeadlineEnd = deadline,
                Status = status
            });

            if (withinDeadline) continue;
            if (isSubmitted || isUnlocked) continue;
            var priors = AppConstants.PriorFyMonthsRequired(m);
            _unlockableMonths.Add(new UnlockMonthRow
            {
                Month = m,
                DeadlineEnd = deadline,
                PriorGaps = priors.Count(p => !submitted.Contains(p))
            });
        }
    }

    private async Task EnableMonthUnlockAsync(string month)
    {
        if (_unlockMode == "CAPITAL" && !_unlockProjectId.HasValue)
        {
            Snackbar.Add("Select the required project first.", Severity.Warning);
            return;
        }
        if (_unlockMode == "REVENUE" && !_unlockSectionId.HasValue)
        {
            Snackbar.Add("Select the required section first.", Severity.Warning);
            return;
        }

        var fy = AppConstants.CurrentFinancialYear();
        var details = new List<ConfirmDialog.DialogDetailRow>
        {
            new("Unlock type", _unlockMode == "CAPITAL" ? "Capital (project)" : "Revenue (section)"),
            new("Financial year", fy),
            new("Month", month, "accent")
        };
        if (_unlockMode == "CAPITAL")
        {
            var p = _unlockProjects.FirstOrDefault(x => x.ProjectId == _unlockProjectId);
            details.Add(new("Project", p?.ProjectName ?? _unlockProjectId?.ToString() ?? ""));
        }
        else
        {
            var s = _unlockSections.FirstOrDefault(x => x.SectionId == _unlockSectionId);
            details.Add(new("Section", s?.SectionName ?? _unlockSectionId?.ToString() ?? ""));
        }

        var confirmed = await ConfirmAsync(
            "Confirm month unlock",
            "Enable this month for Maker entry after the deadline? This writes ENTRY_MONTH_UNLOCK.",
            "Enable month",
            Color.Primary,
            month,
            details,
            Icons.Material.Filled.LockOpen);
        if (!confirmed) return;

        _unlockBusy = true;
        try
        {
            var actor = AuthService.CurrentUser!.PfNo;

            ServiceResult result;
            if (_unlockMode == "CAPITAL" && _unlockProjectId.HasValue)
            {
                result = await MasterService.EnableMonthUnlockAsync(
                    _unlockProjectId.Value, null, fy, month, actor);
            }
            else if (_unlockMode == "REVENUE" && _unlockSectionId.HasValue)
            {
                result = await MasterService.EnableMonthUnlockAsync(
                    null, _unlockSectionId.Value, fy, month, actor);
            }
            else
            {
                Snackbar.Add("Select the required project or section first.", Severity.Warning);
                return;
            }

            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
            if (result.Success)
                await LoadUnlockableMonthsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unlock failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _unlockBusy = false;
        }
    }

    private async Task<bool> ConfirmAsync(
        string title,
        string message,
        string confirmText,
        Color color,
        string? subtitle,
        List<ConfirmDialog.DialogDetailRow>? details,
        string? icon = null)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, title },
            { x => x.Subtitle, subtitle },
            { x => x.Message, message },
            { x => x.Details, details },
            { x => x.ConfirmText, confirmText },
            { x => x.CancelText, "Cancel" },
            { x => x.ConfirmColor, color },
            { x => x.Icon, icon }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private sealed class UnlockMonthRow
    {
        public string Month { get; set; } = "";
        public DateTime DeadlineEnd { get; set; }
        public int PriorGaps { get; set; }
    }

    private sealed class UnlockStatusRow
    {
        public string Month { get; set; } = "";
        public DateTime DeadlineEnd { get; set; }
        public string Status { get; set; } = "";
    }

    private sealed class StaffPreviewRow
    {
        public string Role { get; set; } = "";
        public string Pf { get; set; } = "";
        public string Name { get; set; } = "";
        public string Designation { get; set; } = "";
        public string? Scale { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
    }
