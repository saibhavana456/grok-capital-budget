@page "/capital/entry"
@attribute [Authorize(Roles = "MAKER")]
@inject ICapitalService CapitalService
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="entry-page">
    <MudText Typo="Typo.h5" Class="page-title">Capital Monthly Entry</MudText>

    @if (_form != null)
    {
        <MudText Class="page-context mb-3">
            @_form.DeptName · @_form.SectionName · @_form.ProjectName · Amounts in Rs. Crore
        </MudText>

        <MudPaper Class="pa-4 mb-3 portal-card" Elevation="0">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="_form.FinancialYear" Label="Financial Year" Variant="Variant.Outlined"
                               ValueChanged="OnFyChanged">
                        <MudSelectItem Value="@("2026-27")">2026-27</MudSelectItem>
                        <MudSelectItem Value="@("2025-26")">2025-26</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="_form.EntryMonth" Label="Entry Month" Variant="Variant.Outlined"
                               ValueChanged="OnMonthChanged">
                        @foreach (var m in AppConstants.FyMonths)
                        {
                            <MudSelectItem Value="@m" Disabled="@AppConstants.IsFutureMonth(m)">@m</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_isLocked && _existing != null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                Already submitted for <b>@_form.EntryMonth</b> — status <b>@_existing.Status</b>
                (PF @(_existing.SubmittedByPf ?? "-")).
                <MudLink Href="@($"/capital/view/{_existing.EntryId}")" Class="ml-2">View submission</MudLink>
            </MudAlert>
        }
        else if (!_canSubmit)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                No submission for <b>@_form.EntryMonth</b>. New entry is allowed only for the
                <b>current</b> and <b>previous</b> calendar months.
            </MudAlert>
        }
        else
        {
            @if (_isResubmit && _existing != null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                    Status <b>@_existing.Status</b> — edit and resubmit for the same month.
                    @if (!string.IsNullOrWhiteSpace(_existing.CheckerRemark))
                    {
                        <div class="mt-1">Checker remark: @_existing.CheckerRemark</div>
                    }
                </MudAlert>
            }

            <MudPaper Class="allotted-strip pa-4 mb-3" Elevation="0">
                <MudText Class="section-heading mb-3">Allotted Budget (FY @_form.FinancialYear)</MudText>
                <div class="metric-row"><span class="metric-row-label">Spillover Allotted</span><span class="metric-row-value">@_form.SpilloverAllotted.ToString("0.00") <small>Cr</small></span></div>
                <div class="metric-row"><span class="metric-row-label">Fresh Allotted</span><span class="metric-row-value">@_form.FreshAllotted.ToString("0.00") <small>Cr</small></span></div>
                <div class="metric-row"><span class="metric-row-label">Total Allotted</span><span class="metric-row-value">@_form.TotalAllotted.ToString("0.00") <small>Cr</small></span></div>
                <div class="metric-row accent"><span class="metric-row-label">Utilized till @PrevMonth</span><span class="metric-row-value accent">@_form.UtilizedTillPreviousMonth.ToString("0.00") <small>Cr</small></span></div>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4 panel-readonly h-100" Elevation="0">
                        <MudText Class="section-heading mb-3">Previous Month (@PrevMonth.ToUpperInvariant())</MudText>
                        <div class="metric-row"><span class="metric-row-label">Spillover Utilized</span><span class="metric-row-value">@_form.PrevSpillover.ToString("0.00")</span></div>
                        <div class="metric-row"><span class="metric-row-label">Fresh Utilized</span><span class="metric-row-value">@_form.PrevFresh.ToString("0.00")</span></div>
                        <div class="metric-row accent"><span class="metric-row-label">Total Utilized</span><span class="metric-row-value">@_form.PrevTotal.ToString("0.00")</span></div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4 panel-entry h-100" Elevation="0">
                        <MudText Class="section-heading mb-3">Current Month (@CurrMonth.ToUpperInvariant())</MudText>
                        <MudNumericField @bind-Value="_form.ActualSpillover"
                                         Label="@($"Actual Spillover Utilization for {CurrMonth} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-3" Required="true" />
                        <MudNumericField @bind-Value="_form.ActualFresh"
                                         Label="@($"Actual Fresh Utilization for {CurrMonth} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-2" Required="true" />
                        <div class="metric-row mb-3"><span class="metric-row-label">Actual Total (auto)</span><span class="metric-row-value">@((_form.ActualSpillover + _form.ActualFresh).ToString("0.00"))</span></div>

                        <MudDivider Class="my-3" />

                        <MudText Class="section-heading mb-3">Estimates for @NextMon.ToUpperInvariant()</MudText>
                        <MudNumericField @bind-Value="_form.EstSpilloverNext"
                                         Label="@($"Estimated Spillover for {NextMon} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-3" Required="true" />
                        <MudNumericField @bind-Value="_form.EstFreshNext"
                                         Label="@($"Estimated Fresh for {NextMon} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-2" Required="true" />
                        <div class="metric-row"><span class="metric-row-label">Estimated Total (auto)</span><span class="metric-row-value">@((_form.EstSpilloverNext + _form.EstFreshNext).ToString("0.00"))</span></div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4 mt-3 portal-card" Elevation="0">
                <MudText Class="justification-title mb-2">Justification</MudText>
                <MudTextField @bind-Value="_form.JustificationText"
                              Variant="Variant.Outlined"
                              Lines="4"
                              Required="true"
                              RequiredError="@AppConstants.JustificationRequiredMessage"
                              Counter="AppConstants.JustificationMaxLength"
                              MaxLength="AppConstants.JustificationMaxLength"
                              HelperText="@($"{(_form.JustificationText?.Length ?? 0)} / {AppConstants.JustificationMaxLength}")" />
            </MudPaper>

            <MudStack Row="true" Class="mt-4" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_busy" OnClick="Submit"
                           Style="background:#c8102e;">
                    @(_busy ? "Submitting..." : (_isResubmit ? "Resubmit for Approval" : "Submit for Approval"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/portal">Back to Portal</MudButton>
            </MudStack>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] public long? ProjectId { get; set; }
    [SupplyParameterFromQuery] public string? Month { get; set; }

    private CapitalEntryFormDto? _form;
    private ExistingEntryInfo? _existing;
    private bool _busy;
    private bool _canSubmit;
    private bool _isLocked;
    private bool _isResubmit;

    private string CurrMonth => _form?.EntryMonth ?? "";
    private string PrevMonth => string.IsNullOrEmpty(CurrMonth) ? "" : AppConstants.PreviousMonth(CurrMonth);
    private string NextMon => string.IsNullOrEmpty(CurrMonth) ? "" : AppConstants.NextMonth(CurrMonth);

    protected override async Task OnInitializedAsync()
    {
        if (!ProjectId.HasValue)
        {
            Snackbar.Add("Project is required.", Severity.Warning);
            Nav.NavigateTo("/portal");
            return;
        }

        var month = !string.IsNullOrWhiteSpace(Month) && AppConstants.CanOpenMonth(Month)
            ? Month!
            : AppConstants.DefaultEntryMonth();
        await Load(AppConstants.DefaultFinancialYear, month);
    }

    private async Task Load(string fy, string month)
    {
        if (AppConstants.IsFutureMonth(month))
            month = AppConstants.DefaultEntryMonth();

        _form = await CapitalService.BuildFormAsync(ProjectId!.Value, fy, month);
        if (_form == null)
        {
            Snackbar.Add("Unable to load capital form.", Severity.Error);
            _existing = null;
            _canSubmit = false;
            _isLocked = false;
            _isResubmit = false;
            return;
        }

        _existing = await CapitalService.FindActiveEntryAsync(ProjectId.Value, fy, month);
        _isLocked = _existing != null && AppConstants.IsLockedStatus(_existing.Status);
        _isResubmit = _existing != null && AppConstants.IsEditableStatus(_existing.Status);
        _canSubmit = !_isLocked && (
            _isResubmit ||
            (_existing == null && AppConstants.IsAllowedEntryMonth(month)));
    }

    private async Task OnMonthChanged(string month)
    {
        if (_form == null || !ProjectId.HasValue || AppConstants.IsFutureMonth(month)) return;
        await Load(_form.FinancialYear, month);
    }

    private async Task OnFyChanged(string fy)
    {
        if (_form == null || !ProjectId.HasValue) return;
        await Load(fy, _form.EntryMonth);
    }

    private async Task Submit()
    {
        if (_form == null || !_canSubmit) return;
        var user = AuthService.CurrentUser;
        if (user == null) { Nav.NavigateTo("/login"); return; }

        if (string.IsNullOrWhiteSpace(_form.JustificationText))
        {
            Snackbar.Add(AppConstants.JustificationRequiredMessage, Severity.Warning);
            return;
        }

        var actualTotal = _form.ActualSpillover + _form.ActualFresh;
        var allZero = _form.ActualSpillover == 0 && _form.ActualFresh == 0
                      && _form.EstSpilloverNext == 0 && _form.EstFreshNext == 0;
        var overBudget = _form.ActualSpillover > _form.SpilloverAllotted
                         || _form.ActualFresh > _form.FreshAllotted
                         || actualTotal > _form.TotalAllotted;

        if (allZero && !await ConfirmAsync(AppConstants.ConfirmZeroTitle, AppConstants.ConfirmZeroMessage, "Submit", Color.Warning))
            return;
        if (overBudget && !await ConfirmAsync(AppConstants.ConfirmOverBudgetTitle, AppConstants.ConfirmOverBudgetMessage, "Submit anyway", Color.Warning))
            return;
        if (!await ConfirmAsync(AppConstants.ConfirmSubmitTitle, AppConstants.ConfirmSubmitMessage, "Submit", Color.Primary))
            return;

        _busy = true;
        try
        {
            var result = await CapitalService.SubmitAsync(_form, user.PfNo);
            if (!result.Success)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }
            Snackbar.Add(result.Message, Severity.Success);
            Nav.NavigateTo("/capital/submissions");
        }
        finally { _busy = false; }
    }

    private async Task<bool> ConfirmAsync(string title, string message, string confirmText, Color color)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, title },
            { x => x.Message, message },
            { x => x.ConfirmText, confirmText },
            { x => x.ConfirmColor, color }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }
}
