@page "/capital/entry"
@attribute [Authorize(Roles = "MAKER,ADMIN")]
@inject ICapitalService CapitalService
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="entry-page">
    <MudText Typo="Typo.h5" Class="page-title">Capital Monthly Entry</MudText>

    @if (_form != null)
    {
        <MudText Class="page-context mb-3">
            @_form.DeptName · @_form.SectionName · @_form.ProjectName · Amounts in Rs. Crore
        </MudText>

        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Value="_form.FinancialYear" Label="Financial Year" Variant="Variant.Outlined"
                               ValueChanged="OnFyChanged">
                        <MudSelectItem Value="@("2026-27")">2026-27</MudSelectItem>
                        <MudSelectItem Value="@("2025-26")">2025-26</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Value="_form.EntryMonth" Label="Entry Month" Variant="Variant.Outlined"
                               ValueChanged="OnMonthChanged">
                        @foreach (var m in _allowedMonths)
                        {
                            <MudSelectItem Value="@m">@m</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_existing != null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                An entry already exists for <b>@_form.EntryMonth</b> (@_existing.Status)
                — submitted by @(_existing.SubmittedByPf ?? "-").
                New entry for this project / FY / month is not allowed (write-lock).
                <MudLink Href="@($"/capital/view/{_existing.EntryId}")" Class="ml-2">View existing</MudLink>
            </MudAlert>
        }
        else
        {
            <MudPaper Class="allotted-strip pa-3 mb-3" Elevation="1">
                <MudText Class="section-heading mb-2">Allotted Budget (FY @_form.FinancialYear)</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <div class="metric-cell">
                            <span class="meta-label">Spillover Allotted</span>
                            <span class="meta-value">@_form.SpilloverAllotted.ToString("0.00") Cr</span>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <div class="metric-cell">
                            <span class="meta-label">Fresh Allotted</span>
                            <span class="meta-value">@_form.FreshAllotted.ToString("0.00") Cr</span>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <div class="metric-cell">
                            <span class="meta-label">Total Allotted</span>
                            <span class="meta-value accent">@_form.TotalAllotted.ToString("0.00") Cr</span>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4 panel-readonly h-100" Elevation="0">
                        <MudText Class="section-heading mb-3">
                            Previous Month (@PrevMonth.ToUpperInvariant())
                        </MudText>
                        <MudGrid>
                            <MudItem xs="4">
                                <div class="metric-cell">
                                    <span class="meta-label">Spillover</span>
                                    <span class="meta-value">@_form.PrevSpillover.ToString("0.00")</span>
                                </div>
                            </MudItem>
                            <MudItem xs="4">
                                <div class="metric-cell">
                                    <span class="meta-label">Fresh</span>
                                    <span class="meta-value">@_form.PrevFresh.ToString("0.00")</span>
                                </div>
                            </MudItem>
                            <MudItem xs="4">
                                <div class="metric-cell">
                                    <span class="meta-label">Total</span>
                                    <span class="meta-value">@_form.PrevTotal.ToString("0.00")</span>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4 panel-entry h-100" Elevation="0">
                        <MudText Class="section-heading mb-3">
                            Current Month (@CurrMonth.ToUpperInvariant())
                        </MudText>
                        <MudNumericField @bind-Value="_form.ActualSpillover"
                                         Label="@($"Actual Spillover Utilization for {CurrMonth} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-2" />
                        <MudNumericField @bind-Value="_form.ActualFresh"
                                         Label="@($"Actual Fresh Utilization for {CurrMonth} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-2" />
                        <MudText Class="mb-3 meta-value" Style="font-size:0.95rem;">
                            Actual Total for @CurrMonth (auto): @((_form.ActualSpillover + _form.ActualFresh).ToString("0.00"))
                        </MudText>

                        <MudDivider Class="my-3" />

                        <MudText Class="section-heading mb-3">
                            Estimates for @NextMon.ToUpperInvariant()
                        </MudText>
                        <MudNumericField @bind-Value="_form.EstSpilloverNext"
                                         Label="@($"Estimated Spillover for {NextMon} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-2" />
                        <MudNumericField @bind-Value="_form.EstFreshNext"
                                         Label="@($"Estimated Fresh for {NextMon} (Rs. Cr)")"
                                         Variant="Variant.Outlined" Min="0" Class="mb-2" />
                        <MudText Class="meta-value" Style="font-size:0.95rem;">
                            Estimated Total for @NextMon (auto): @((_form.EstSpilloverNext + _form.EstFreshNext).ToString("0.00"))
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4 mt-3" Elevation="1">
                <MudText Class="justification-title mb-2">Justifications (PO details, Invoice details, etc.)</MudText>
                <MudTextField @bind-Value="_form.JustificationText"
                              Variant="Variant.Outlined"
                              Lines="4"
                              Counter="AppConstants.JustificationMaxLength"
                              MaxLength="AppConstants.JustificationMaxLength"
                              HelperText="@($"{(_form.JustificationText?.Length ?? 0)} / {AppConstants.JustificationMaxLength}")" />
            </MudPaper>

            <MudStack Row="true" Class="mt-4" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_busy" OnClick="Submit"
                           Style="background:#c8102e;">
                    @(_busy ? "Submitting..." : "Submit for Approval")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/portal">Back to Portal</MudButton>
            </MudStack>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] public long? ProjectId { get; set; }

    private CapitalEntryFormDto? _form;
    private ExistingEntryInfo? _existing;
    private bool _busy;
    private IReadOnlyList<string> _allowedMonths = AppConstants.AllowedEntryMonths();

    private string CurrMonth => _form?.EntryMonth ?? "";
    private string PrevMonth => string.IsNullOrEmpty(CurrMonth) ? "" : AppConstants.PreviousMonth(CurrMonth);
    private string NextMon => string.IsNullOrEmpty(CurrMonth) ? "" : AppConstants.NextMonth(CurrMonth);

    protected override async Task OnInitializedAsync()
    {
        if (!ProjectId.HasValue)
        {
            Snackbar.Add("Project is required.", Severity.Warning);
            Nav.NavigateTo("/portal");
            return;
        }
        await Load(AppConstants.DefaultFinancialYear, AppConstants.DefaultEntryMonth());
    }

    private async Task Load(string fy, string month)
    {
        if (!AppConstants.IsAllowedEntryMonth(month))
            month = AppConstants.DefaultEntryMonth();

        _form = await CapitalService.BuildFormAsync(ProjectId!.Value, fy, month);
        if (_form == null)
        {
            Snackbar.Add("Unable to load capital form.", Severity.Error);
            _existing = null;
            return;
        }
        _existing = await CapitalService.FindActiveEntryAsync(ProjectId.Value, fy, month);
    }

    private async Task OnMonthChanged(string month)
    {
        if (_form == null || !ProjectId.HasValue) return;
        await Load(_form.FinancialYear, month);
    }

    private async Task OnFyChanged(string fy)
    {
        if (_form == null || !ProjectId.HasValue) return;
        await Load(fy, _form.EntryMonth);
    }

    private async Task Submit()
    {
        if (_form == null || _existing != null) return;
        var user = AuthService.CurrentUser;
        if (user == null) { Nav.NavigateTo("/login"); return; }

        _busy = true;
        try
        {
            var result = await CapitalService.SubmitAsync(_form, user.PfNo);
            if (!result.Success)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }
            Snackbar.Add(result.Message, Severity.Success);
            Nav.NavigateTo("/capital/submissions");
        }
        finally { _busy = false; }
    }
}
