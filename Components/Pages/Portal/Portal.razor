@page "/"
@page "/portal"
@attribute [Authorize]
@inject IMasterService MasterService
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="entry-page">
    <MudText Typo="Typo.h5" Class="page-title">IT Budget Portal</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_isCheckerOnly)
    {
        <MudPaper Class="pa-4 mb-4 portal-card" Elevation="0">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Capital entry and Revenue entry allow <b>MAKER</b> and <b>ADMIN</b> only.
                As Checker (PF @_userPf), use <b>Checker Review</b> to Approve / Return / Reject.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/checker">
                Go to Checker Review
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4 portal-card" Elevation="0">
            <MudText Class="section-heading mb-3">Select details to continue</MudText>

            <MudSelect T="long?" Label="Department" Variant="Variant.Outlined" Class="mb-3"
                       Value="_deptId" ValueChanged="OnDeptChanged" AnchorOrigin="Origin.BottomCenter">
                @foreach (var d in _departments)
                {
                    <MudSelectItem T="long?" Value="@((long?)d.DeptId)">@d.DeptName</MudSelectItem>
                }
            </MudSelect>

            @if (_showBudgetType)
            {
                <MudSelect T="string" Label="Budget Type" Variant="Variant.Outlined" Class="mb-3"
                           Value="_budgetType" ValueChanged="OnBudgetTypeChanged"
                           Disabled="!_deptId.HasValue">
                    <MudSelectItem Value="@("CAPITAL")">Capital</MudSelectItem>
                    <MudSelectItem Value="@("REVENUE")">Revenue</MudSelectItem>
                </MudSelect>
            }

            <MudSelect T="long?" Label="Section" Variant="Variant.Outlined" Class="mb-3"
                       Value="_sectionId" ValueChanged="OnSectionChanged"
                       Disabled="!CanSelectSection">
                @foreach (var s in _sections)
                {
                    <MudSelectItem T="long?" Value="@((long?)s.SectionId)">@s.SectionName</MudSelectItem>
                }
            </MudSelect>

            @if (IsCapitalPath)
            {
                <MudSelect T="long?" Label="Project" Variant="Variant.Outlined" Class="mb-3"
                           Value="_projectId" ValueChanged="OnProjectChanged"
                           Disabled="_projects.Count==0 || !_sectionId.HasValue">
                    @foreach (var p in _projects)
                    {
                        <MudSelectItem T="long?" Value="@((long?)p.ProjectId)">@p.ProjectName</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudSelect T="string" Label="Entry Month" Variant="Variant.Outlined" Class="mb-3"
                       Value="_month" ValueChanged="OnMonthChanged"
                       HelperText="All months shown. Future months are disabled. Open a past/current month to enter or view an existing submission.">
                @foreach (var m in AppConstants.FyMonths)
                {
                    <MudSelectItem Value="@m" Disabled="@AppConstants.IsFutureMonth(m)">
                        @m @(AppConstants.IsFutureMonth(m) ? "(future)" : "")
                    </MudSelectItem>
                }
            </MudSelect>

            <MudStack Row="true" Class="mt-2" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanContinue" OnClick="Continue">
                    Continue to Entry
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</div>

@code {
    private bool _loading = true;
    private List<Department> _departments = new();
    private List<Section> _sections = new();
    private List<Project> _projects = new();
    private long? _deptId;
    private long? _sectionId;
    private long? _projectId;
    private string _budgetType = "CAPITAL";
    private string _month = AppConstants.DefaultEntryMonth();
    private bool _showBudgetType;
    private bool _isCheckerOnly;
    private string _userPf = "";

    private bool IsCapitalPath => !_showBudgetType || _budgetType == "CAPITAL";

    private bool CanSelectSection =>
        _deptId.HasValue && (!_showBudgetType || !string.IsNullOrWhiteSpace(_budgetType));

    private bool CanContinue =>
        !_isCheckerOnly &&
        _deptId.HasValue &&
        _sectionId.HasValue &&
        !string.IsNullOrWhiteSpace(_month) &&
        AppConstants.CanOpenMonth(_month) &&
        (IsCapitalPath ? _projectId.HasValue : _showBudgetType && _budgetType == "REVENUE");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = AuthService.CurrentUser;
            _userPf = user?.PfNo ?? "";
            _isCheckerOnly = user?.RoleCode == AppConstants.Roles.Checker;
            if (_isCheckerOnly) return;

            _departments = await MasterService.GetDepartmentsAsync();
            if (user?.DeptId != null)
            {
                _deptId = user.DeptId;
                await OnDeptChanged(_deptId);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnDeptChanged(long? deptId)
    {
        _deptId = deptId;
        _sectionId = null;
        _projectId = null;
        _sections.Clear();
        _projects.Clear();
        _showBudgetType = false;
        _budgetType = "CAPITAL";

        if (!deptId.HasValue) return;
        var dept = _departments.FirstOrDefault(d => d.DeptId == deptId.Value);
        _showBudgetType = dept?.HasRevenue == "Y";
        _sections = await MasterService.GetSectionsByDeptAsync(deptId.Value);
    }

    private async Task OnBudgetTypeChanged(string type)
    {
        _budgetType = type;
        _sectionId = null;
        _projectId = null;
        _projects.Clear();
        if (_deptId.HasValue)
            _sections = await MasterService.GetSectionsByDeptAsync(_deptId.Value);
    }

    private async Task OnSectionChanged(long? sectionId)
    {
        _sectionId = sectionId;
        _projectId = null;
        _projects.Clear();
        if (!sectionId.HasValue) return;
        if (IsCapitalPath)
            _projects = await MasterService.GetProjectsBySectionAsync(sectionId.Value);
    }

    private Task OnProjectChanged(long? projectId)
    {
        _projectId = projectId;
        return Task.CompletedTask;
    }

    private Task OnMonthChanged(string month)
    {
        if (AppConstants.IsFutureMonth(month)) return Task.CompletedTask;
        _month = month;
        return Task.CompletedTask;
    }

    private void Continue()
    {
        if (_isCheckerOnly || !CanContinue) return;

        if (!IsCapitalPath)
            Nav.NavigateTo($"/revenue/entry?sectionId={_sectionId}&month={Uri.EscapeDataString(_month)}");
        else
            Nav.NavigateTo($"/capital/entry?projectId={_projectId}&month={Uri.EscapeDataString(_month)}");
    }
}
