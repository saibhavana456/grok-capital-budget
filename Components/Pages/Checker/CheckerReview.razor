@page "/checker"
@attribute [Authorize(Roles = "CHECKER")]
@inject ICapitalService CapitalService
@inject IRevenueService RevenueService
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<div class="checker-page">
    <MudPaper Class="pa-4 mb-3" Elevation="1" Style="border-radius:10px;">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="3">
            <div>
                <MudText Typo="Typo.h5" Style="color:#003366;font-weight:700;">Checker Review</MudText>
                <MudText Typo="Typo.body2" Class="mt-1" Style="color:#64748b;max-width:640px;">
                    Open View to Approve, Return, or Reject pending submissions for your department
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2" Class="mt-1">
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Medium">
                    Capital: @_capital.Count pending
                </MudChip>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                    Revenue: @_revenue.Count pending
                </MudChip>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Style="border-radius:10px;overflow:hidden;">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                 PanelClass="pa-3" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="@($"Capital Pending ({_capital.Count})")">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Class="mb-2" />
                }
                else if (_capital.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-1">
                        No pending Capital submissions for your department.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="_capital" Hover="true" Dense="true" Striped="true"
                              Breakpoint="Breakpoint.Sm" Elevation="0" Class="checker-table">
                        <HeaderContent>
                            <MudTh>FY</MudTh>
                            <MudTh>Month</MudTh>
                            <MudTh>Section</MudTh>
                            <MudTh>Project</MudTh>
                            <MudTh>Maker</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align:right;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="FY">@context.FinancialYear</MudTd>
                            <MudTd DataLabel="Month"><b>@context.Month</b></MudTd>
                            <MudTd DataLabel="Section">@context.SectionName</MudTd>
                            <MudTd DataLabel="Project">@context.ProjectName</MudTd>
                            <MudTd DataLabel="Maker">@context.SubmittedByPf</MudTd>
                            <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
                            <MudTd DataLabel="Action" Class="checker-actions-cell">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           Href="@($"/capital/view/{context.EntryId}")">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 5, 10, 25 }" />
                        </PagerContent>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Revenue Pending ({_revenue.Count})")">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Class="mb-2" />
                }
                else if (_revenue.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-1">
                        No pending Revenue submissions for your department.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="_revenue" Hover="true" Dense="true" Striped="true"
                              Breakpoint="Breakpoint.Sm" Elevation="0" Class="checker-table">
                        <HeaderContent>
                            <MudTh>FY</MudTh>
                            <MudTh>Month</MudTh>
                            <MudTh>Section</MudTh>
                            <MudTh>Total (Cr)</MudTh>
                            <MudTh>Maker</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align:right;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="FY">@context.FinancialYear</MudTd>
                            <MudTd DataLabel="Month"><b>@context.Month</b></MudTd>
                            <MudTd DataLabel="Section">@context.SectionName</MudTd>
                            <MudTd DataLabel="Total">@context.TotalAmount.ToString("0.00")</MudTd>
                            <MudTd DataLabel="Maker">@context.SubmittedByPf</MudTd>
                            <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
                            <MudTd DataLabel="Action" Class="checker-actions-cell">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           Href="@($"/revenue/view/{context.EntryId}")">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 5, 10, 25 }" />
                        </PagerContent>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</div>

@code {
    private List<CapitalSubmissionListItem> _capital = new();
    private List<RevenueSubmissionListItem> _revenue = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    private Task OnTabChanged(int _) => Task.CompletedTask;

    private async Task Reload()
    {
        _loading = true;
        try
        {
            var pf = AuthService.CurrentUser?.PfNo ?? "";
            _capital = await CapitalService.GetPendingForCheckerAsync(pf);
            _revenue = await RevenueService.GetPendingForCheckerAsync(pf);
        }
        finally
        {
            _loading = false;
        }
    }
}
