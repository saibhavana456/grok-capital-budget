@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IAuthService AuthService

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<header class="ubi-header">
    <div class="ubi-header-grid">
        <div class="ubi-header-side"></div>
        <div class="ubi-header-center">
            <span class="ubi-brand">Union Bank of India | IT Budget</span>
        </div>
        <div class="ubi-header-side ubi-header-right">
            @if (_user != null)
            {
                <span class="ubi-user">PF @_user.PfNo · @_user.RoleCode</span>
                <button type="button" class="ubi-logout" @onclick="Logout">Logout</button>
            }
        </div>
    </div>
</header>

@if (_user != null)
{
    <div class="nav-tabs-ubi px-4">
        @if (_user.RoleCode == AppConstants.Roles.Maker)
        {
            <NavLink href="/portal" Match="NavLinkMatch.Prefix">IT Budget</NavLink>
        }
        @if (_user.RoleCode == AppConstants.Roles.Checker)
        {
            <NavLink href="/checker" Match="NavLinkMatch.Prefix">Checker Review</NavLink>
        }
        @if (_user.RoleCode == AppConstants.Roles.Admin)
        {
            <NavLink href="/admin/masters" Match="NavLinkMatch.Prefix">Admin Masters</NavLink>
        }
        <NavLink href="/capital/submissions">Capital Submissions</NavLink>
        <NavLink href="/revenue/submissions">Revenue Submissions</NavLink>
    </div>
}

<main class="pa-4" style="min-height:calc(100vh - 110px);">
    @Body
</main>

@code {
    private LoggedInUserDto? _user;
    private bool _checkingSession;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#003366",
            Secondary = "#c8102e",
            AppbarBackground = "#002147",
            Background = "#eef1f5",
            Surface = "#ffffff"
        }
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshUserFromAuthAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshUserFromAuthAsync();
    }

    private async Task RefreshUserFromAuthAsync()
    {
        if (_checkingSession) return;
        _checkingSession = true;
        try
        {
            if (AuthStateProvider is CustomAuthStateProvider custom)
            {
                // In-app NavLink does not open a new circuit — must re-check USER_TOKEN here.
                // F5 already re-checks in InitializeFromCircuitAsync.
                var stillValid = await custom.EnsureSessionStillValidAsync();
                if (!stillValid)
                {
                    // Clear THIS browser's cookie only — do not delete USER_TOKEN
                    // (the other browser may own the active session).
                    Nav.NavigateTo("/account/expire-cookie", forceLoad: true);
                    return;
                }
            }
            else
            {
                await AuthStateProvider.GetAuthenticationStateAsync();
            }

            _user = AuthService.CurrentUser;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _checkingSession = false;
        }
    }

    private void Logout()
    {
        // Explicit logout: clear USER_TOKEN + cookie
        Nav.NavigateTo("/account/logout", forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
